<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>1.0.16.0</Version>
    <Description>Logs your duty history: name, job, duration, result (Clear/Wipe), rewards, loot, and queue times, with stats and charts.</Description>
    <PackageProjectUrl>https://github.com/Kriss-Hietala/DutyLedger</PackageProjectUrl>

    <!--
      Required for InventoryManager.Instance()->GetInventoryItemCount() in
      Plugin.cs, used for the live tomestone-cap check (FFXIVClientStructs).
      Dalamud.NET.Sdk enables this by default in most recent versions, but
      setting it explicitly avoids CS0227 if that ever changes.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Dalamud.NET.Sdk/15.0.0 already includes DalamudPackager 15.0.0 and
    FFXIVClientStructs by default. Do NOT add separate PackageReferences for
    either - it caused an NU1504 duplicate-reference warning previously.
  -->

</Project>
